<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="62dp"
    android:layout_height="80dp"
    android:layout_marginEnd="9dp">

    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_glow"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/day_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#1D1713"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#2D241F"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="SUN"
                android:textColor="#8F837B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="8"
                android:textColor="#EDE7E2"
                android:textSize="18sp" />

            <View
                android:id="@+id/day_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/dot" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>