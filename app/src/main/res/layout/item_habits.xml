<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1c1511"
    app:cardCornerRadius="15dp"
    app:cardElevation="8dp"
    android:layout_marginBottom="8dp"
    app:strokeColor="#FFFFFF"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp">

        <!-- HABIT EMOJI CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/habit_emoji_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#251c17"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/habit_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:text="🎯"
                    android:textSize="16sp" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- HABIT TITLE AND DESCRIPTION -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@id/habit_emoji_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/habit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:text="Morning Meditation"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#d8c3ad"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/habit_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_light"
                    android:text="Description"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#d8c3ad"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/habit_completion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    android:fontFamily="@font/montserrat_light"
                    android:text="Completed"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:textColor="#30c88f"
                    android:textSize="11sp" />

            </LinearLayout>


        </LinearLayout>

        <!-- DONE CHECKMARK -->
        <androidx.cardview.widget.CardView
            android:id="@+id/habit_done_checkmark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#f59e0b">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/done" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</androidx.cardview.widget.CardView>