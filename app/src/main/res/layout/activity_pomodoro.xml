<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".PomodoroActivity">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="Focus Session"
            android:textColor="@color/white"
            android:textSize="23sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/session_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:cardBackgroundColor="#211a15"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeColor="#3d3d3d"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#211a15"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/calendar_icon"
                    android:layout_width="14dp"
                    android:layout_height="16dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/electric"
                    app:tint="#f59e0b" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/calendar_icon"
                    android:fontFamily="@font/montserrat_regular"
                    android:includeFontPadding="false"
                    android:text="Session 3 of 4"
                    android:textColor="#d8c3ad"
                    android:textSize="12sp" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <!-- SWITCHER -->
    <LinearLayout
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <androidx.cardview.widget.CardView
            android:id="@+id/focus_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1c1511"
            app:cardCornerRadius="30dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/montserrat_regular"
                    android:padding="10dp"
                    android:text="Focus 25m"
                    android:textColor="#d8c3ad" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/short_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2.5dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1c1511"
            app:cardCornerRadius="30dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/montserrat_regular"
                    android:padding="10dp"
                    android:text="Short 5m"
                    android:textColor="#d8c3ad" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/long_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2.5dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1c1511"
            app:cardCornerRadius="30dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/montserrat_regular"
                    android:padding="10dp"
                    android:text="Long 15m"
                    android:textColor="#d8c3ad" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/switcher"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_timer_card"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/glow"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_glow"
            android:translationX="-50dp"
            android:translationY="-20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Session title -->
            <LinearLayout
                android:id="@+id/sessionHeader"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_header"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/sessionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:maxLines="1"
                    android:text="Writing System Architecture"
                    android:textColor="#F5F0EA"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/edit"
                    app:tint="#ffb45b" />

            </LinearLayout>

            <!-- Timer ring and text -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/timerContainer"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center">

                    <com.arijit.rise.components.TimerRingView
                        android:id="@+id/timerRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/timerText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="25:00"
                            android:textColor="#FFFFFF"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:letterSpacing="0.12"
                            android:text="♨  STAY IN FLOW"
                            android:textColor="#FFA500"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Timer controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resetButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_control"
                    android:clickable="true"
                    android:contentDescription="Reset timer"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="↶"
                    android:textColor="#D5CBC1"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/playButton"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_play"
                    android:clickable="true"
                    android:contentDescription="Start or pause timer"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#160F05"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/skipButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_control"
                    android:clickable="true"
                    android:contentDescription="Skip timer"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▸|"
                    android:textColor="#D5CBC1"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>